# ═══════════════════════════════════════════════════════════
#  Job Application Agent — environment config
#  Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# ── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── LinkedIn (Option B — unofficial API, no registration) ──
# Just your normal LinkedIn login. That's it.
# The library reuses cookies after the first login so you
# won't be prompted every run.
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# ── Email outreach (Gmail recommended) ────────────────────
# Use a Gmail App Password, NOT your main Gmail password.
# To create one: Google Account → Security → 2-Step Verification
#   → App Passwords → select "Mail" → generate
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx    # 16-char App Password

# ── Job search config ──────────────────────────────────────
TARGET_ROLES=Product Manager,Senior Product Manager,Group Product Manager
TARGET_LOCATIONS=Singapore,Remote
EXCLUDE_COMPANIES=Company A,Company B   # skip these entirely
MAX_JOBS_PER_RUN=50                     # cap per session

# RELEVANCE_THRESHOLD — how loosely to match jobs to your profile
#   0.2  = very broad  (almost everything)
#   0.35 = broad       (default — recommended)
#   0.5  = moderate
#   0.7  = strict
RELEVANCE_THRESHOLD=0.35

# ── Application behaviour ──────────────────────────────────
# confirm → shows preview, waits for your Enter key (recommended to start)
# auto    → submits without asking (use once you trust it)
# draft   → fills everything but never submits (safe for testing)
APPLY_MODE=confirm

# ── Follow-up schedule ─────────────────────────────────────
FOLLOWUP_DAY_1=5
FOLLOWUP_DAY_2=14

# ── File paths ─────────────────────────────────────────────
RESUME_PATH=data/resumes/resume.pdf
ATS_PROFILE_PATH=data/resumes/ats_profile.json
DB_PATH=data/applications/tracker.json
